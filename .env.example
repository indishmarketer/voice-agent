# Copy to .env for local development. NEVER commit the real .env.
# On Coolify, paste these into the application's Environment Variables tab
# instead - they are stored encrypted there and never touch the repo.

# --- Required credentials ---------------------------------------------------
ASSEMBLYAI_API_KEY=
POLLINATIONS_API_KEY=
FISH_API_KEY=
FISH_MODEL_ID=e0ea460db14b4430afb6311708937b6d

# --- Required app secrets ---------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# If this changes, every visitor's memory cookie is invalidated. Set it once.
SECRET_KEY=
# Generate a second one for this. /admin returns 404 without the right token.
ADMIN_TOKEN=

# --- Where the agent is allowed to run --------------------------------------
# Comma separated, no trailing slash. Leave blank ONLY while testing locally.
ALLOWED_ORIGINS=https://voice.yourdomain.com

# --- Bot protection (free, strongly recommended) ----------------------------
# From https://dash.cloudflare.com -> Turnstile -> Add site (Invisible widget)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Usage limits -----------------------------------------------------------
# AssemblyAI enforces SESSION_MAX_SECONDS itself, per token.
SESSION_MAX_SECONDS=420
SESSION_IDLE_SECONDS=45
MAX_TURNS_PER_SESSION=25
SESSIONS_PER_IP_PER_DAY=3
SESSIONS_PER_VISITOR_PER_DAY=4
GLOBAL_SESSIONS_PER_DAY=120
# Worst-case speech-to-text budget per day, in seconds. 3600 = one hour a day,
# which stretches a 300 hour free allowance across roughly 300 days.
GLOBAL_STT_SECONDS_PER_DAY=3600
MAX_CONCURRENT_SESSIONS=8

# --- Lead delivery (optional) -----------------------------------------------
# Google Apps Script web app URL - see sheets-webhook.gs
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Branding ---------------------------------------------------------------
BRAND_NAME=Indish Marketer
AGENT_NAME=Indish Marketer Assistant
WEBSITE_URL=https://indishmarketer.com
GREETING=Hi, welcome to Indish Marketer. How can I help you today?

# --- Models (defaults are fine) ---------------------------------------------
POLLINATIONS_MODEL=gemini-fast
AAI_SPEECH_MODEL=universal-3-5-pro
FISH_MODEL=s2.1-pro-free
FISH_LATENCY=balanced
